<?xml version="1.0" encoding="utf-8"?>
<!-- 左上を落とした枠線。9-patch の代わりに、角だけ描いた線を重ねる -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <stroke android:width="1dp" android:color="@color/hud_line" />
        </shape>
    </item>
    <!-- 左上の角を地の色で隠して、斜めの線を引く -->
    <item android:width="9dp" android:height="9dp" android:gravity="top|start">
        <vector android:width="9dp" android:height="9dp" android:viewportWidth="9" android:viewportHeight="9">
            <path android:fillColor="@color/hud_bg" android:pathData="M0,0 L9,0 L0,9 Z" />
            <path android:strokeColor="@color/hud_line" android:strokeWidth="1" android:pathData="M0,8.5 L8.5,0" />
        </vector>
    </item>
</layer-list>
